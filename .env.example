# Local demo mode works without credentials. Configure Supabase before enabling hosted auth/data.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Optional; AI is called only from the backend and falls back safely when unset.
OPENAI_API_KEY=
OPENAI_MODEL=
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./data/learnadapt-demo.sqlite3
APP_MODE=demo
VITE_API_URL=http://localhost:8000
# Browser-safe Supabase public values only; never place service-role or OpenAI keys in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
